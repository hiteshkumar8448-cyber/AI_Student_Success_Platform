@app.post("/api/interventions/{intervention_id}/review")
def faculty_review_intervention(
    intervention_id: str,
    review_data: FacultyInterventionReviewRequest,
    authorization: str | None = Header(default=None)
):

    _, faculty_id = get_authenticated_faculty(
        authorization
    )

    existing, _ = find_intervention(
        intervention_id
    )

    if existing is None:

        raise HTTPException(
            status_code=404,
            detail="Intervention not found"
        )

    verify_faculty_intervention_access(
        existing,
        faculty_id
    )

    status = (
        review_data.status.strip()
        or "Completed"
    )

    feedback = (
        review_data.feedback.strip()
    )

    updated = review_intervention_by_faculty(
        intervention_id,
        faculty_id,
        feedback,
        status=status
    )

    if updated is None:

        raise HTTPException(
            status_code=404,
            detail="Intervention not found"
        )

    # --------------------------------------------------------
    # Store optional outcome/after metrics.
    # --------------------------------------------------------

    extra_updates = {}

    if review_data.outcome is not None:

        extra_updates[
            "outcome"
        ] = review_data.outcome.strip()

    if review_data.after_metrics is not None:

        extra_updates[
            "after_metrics"
        ] = review_data.after_metrics

    if extra_updates:

        updated = update_intervention(
            intervention_id,
            **extra_updates
        )

    return {

        "message":
            "Intervention review submitted successfully",

        "intervention":
            updated
    }


# ============================================================
# STUDENT REPORTS
# ============================================================

@app.post("/api/interventions/{intervention_id}/reports")
async def submit_intervention_report(
    intervention_id: str,
    progress: int = Form(...),
    completed_work: str = Form(""),
    difficulties: str = Form(""),
    next_steps: str = Form(""),
    attachment: UploadFile | None = File(default=None),
    authorization: str | None = Header(default=None)
):

    user = require_student(
        authorization
    )

    intervention, _ = find_intervention(
        intervention_id
    )

    if intervention is None:

        raise HTTPException(
            status_code=404,
            detail="Intervention not found"
        )

    if intervention["student_id"] != user["user_id"]:

        raise HTTPException(
            status_code=403,
            detail="Access denied"
        )

    progress = max(
        0,
        min(
            100,
            int(progress)
        )
    )

    if not completed_work.strip():

        raise HTTPException(
            status_code=400,
            detail="Please describe what you completed."
        )

    attachment_data = None

    if attachment:

        if not attachment.filename:

            raise HTTPException(
                status_code=400,
                detail="Invalid attachment"
            )

        extension = validate_extension(
            attachment.filename,
            INTERVENTION_ALLOWED_EXTENSIONS
        )

        safe_filename = create_safe_filename(
            attachment.filename,
            "intervention_report"
        )

        destination = (
            INTERVENTION_FILES_DIR
            / safe_filename
        )

        file_size = await save_uploaded_file(
            attachment,
            destination
        )

        attachment_data = {

            "original_filename":
                attachment.filename,

            "stored_filename":
                safe_filename,

            "file_type":
                extension.replace(
                    ".",
                    ""
                ).upper(),

            "file_size":
                file_size,

            "file_size_mb":
                round(
                    file_size / (1024 * 1024),
                    2
                ),

            "url":
                f"/intervention-files/{safe_filename}"
        }

    report = add_progress_report(
        user["user_id"],
        intervention_id,
        progress,
        completed_work,
        difficulties,
        next_steps,
        attachment_data
    )

    # --------------------------------------------------------
    # storage.add_progress_report() now handles the shared
    # intervention update.
    #
    # We add the faculty notification here because the current
    # storage function does not know the authenticated faculty
    # session.
    # --------------------------------------------------------

    faculty_id = clean_string(
        intervention.get(
            "faculty_name",
            "FACULTY001"
        ),
        "FACULTY001"
    )

    add_notification(
        "faculty",
        faculty_id,
        "New Student Intervention Report",
        (
            f"{user['user_id']} submitted a "
            f"progress report for "
            f"{intervention['title']}."
        ),
        "report"
    )

    return {

        "message":
            "Intervention report submitted successfully",

        "report":
            report
    }


