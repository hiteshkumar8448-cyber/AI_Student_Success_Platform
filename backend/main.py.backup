# ============================================================
# PYDANTIC MODELS
# ============================================================

class StudentLoginRequest(BaseModel):
    student_id: str
    password: str


class FacultyLoginRequest(BaseModel):
    faculty_id: str
    password: str


class GeneralFacultyNote(BaseModel):
    faculty_name: str = ""
    subject: str = "General"
    note: str


class StudentNoteRequest(BaseModel):
    faculty_name: str = ""
    title: str = "Faculty Note"
    note: str


class InterventionRequest(BaseModel):
    student_id: str
    title: str
    description: str

    priority: str = "Medium"
    due_date: str = ""

    action_type: str = "Academic Support"
    reason_category: str = "General"

    # --------------------------------------------------------
    # Optional fields used by richer Faculty UI versions.
    # They are accepted so the frontend does not fail if these
    # fields are present.
    # --------------------------------------------------------

    reason: str | None = None
    recommended_action: str | None = None
    action_taken: str | None = None
    intervention_date: str | None = None

    baseline_metrics: dict | None = None


class InterventionUpdateRequest(BaseModel):
    title: str | None = None
    description: str | None = None

    status: str | None = None
    progress: int | None = None

    faculty_feedback: str | None = None

    due_date: str | None = None

    action_type: str | None = None
    reason_category: str | None = None

    reason: str | None = None
    recommended_action: str | None = None
    action_taken: str | None = None

    intervention_date: str | None = None

    outcome: str | None = None
    after_metrics: dict | None = None


class StudentInterventionResponseRequest(BaseModel):
    message: str
    progress: int | None = None
    status: str | None = "Responded"


class FacultyInterventionReviewRequest(BaseModel):
    feedback: str = ""
    status: str = "Completed"

    outcome: str | None = None
    after_metrics: dict | None = None


class ReportReviewRequest(BaseModel):
    status: str
    faculty_feedback: str = ""

    outcome: str | None = None
    after_metrics: dict | None = None


# ============================================================
# GENERAL HELPERS
# ============================================================

def now_iso():

    return datetime.now().astimezone().isoformat(
        timespec="seconds"
    )


def safe_int(value, fallback=0):

    try:
        return int(value)

    except (TypeError, ValueError):

        return fallback


def safe_float(value, fallback=0.0):

    try:
        return float(value)

    except (TypeError, ValueError):

        return fallback


def clean_string(value, fallback=""):

    if value is None:
        return fallback

    return str(value).strip()


# ============================================================
# AUTHENTICATED FACULTY HELPERS
# ============================================================

def get_authenticated_faculty(
    authorization
):
    """
    Return the authenticated faculty session.

    All faculty actions should use the authenticated
    faculty ID instead of trusting a faculty ID/name
    supplied by the browser.
    """

    user = require_faculty(
        authorization
    )

    faculty_id = clean_string(
        user.get(
            "user_id",
            "FACULTY001"
        ),
        "FACULTY001"
    )

    return user, faculty_id


def verify_faculty_intervention_access(
    intervention,
    faculty_id
):
    """
    Verify that the current faculty can work with
    an intervention.

    Current project uses a single faculty account, but
    this check keeps the architecture ready for multiple
    faculty accounts.
    """

    if intervention is None:

        raise HTTPException(
            status_code=404,
            detail="Intervention not found"
        )

    assigned_faculty = clean_string(
        intervention.get(
            "faculty_name"
        )
    )

    if not assigned_faculty:

        return True

    # --------------------------------------------------------
    # Current project stores the authenticated faculty ID
    # inside faculty_name.
    #
    # If an older intervention was created using the
    # generic Faculty Administrator name, allow it.
    # --------------------------------------------------------

    if assigned_faculty in {
        faculty_id,
        "Faculty Administrator",
        "FACULTY001"
    }:

        return True

    # --------------------------------------------------------
    # Single-faculty project compatibility.
    # --------------------------------------------------------

    return True


