@app.get("/api/departments")
def departments():

    return sorted(
        df["department"]
        .unique()
        .tolist()
    )


# ============================================================
# SEGMENTS
# ============================================================

@app.get("/api/segments")
def segments():

    counts = (
        df["segment"]
        .value_counts()
    )

    return [

        {
            "segment":
                segment,

            "count":
                int(count)
        }

        for segment, count
        in counts.items()
    ]


