# ============================================================
# INTERVENTION ANALYTICS
# ============================================================

@app.get("/api/interventions/analytics")
def intervention_analytics(
    authorization: str | None = Header(default=None)
):

    require_faculty(
        authorization
    )

    interventions = get_all_interventions()

    total = len(
        interventions
    )

    pending = 0
    acknowledged = 0
    responded = 0
    report_submitted = 0
    completed = 0
    needs_more_work = 0
    under_review = 0

    total_progress = 0

    priorities = {}
    action_types = {}
    reason_categories = {}

    for item in interventions:

        status = clean_string(
            item.get(
                "status",
                "Pending"
            )
        )

        priority = clean_string(
            item.get(
                "priority",
                "Medium"
            )
        )

        action_type = clean_string(
            item.get(
                "action_type",
                "Academic Support"
            )
        )

        reason_category = clean_string(
            item.get(
                "reason_category",
                "General"
            )
        )

        progress = max(
            0,
            min(
                100,
                safe_int(
                    item.get(
                        "progress",
                        0
                    )
                )
            )
        )

        total_progress += progress

        priorities[priority] = (
            priorities.get(
                priority,
                0
            ) + 1
        )

        action_types[action_type] = (
            action_types.get(
                action_type,
                0
            ) + 1
        )

        reason_categories[
            reason_category
        ] = (
            reason_categories.get(
                reason_category,
                0
            ) + 1
        )

        status_lower = status.lower()

        if status_lower == "pending":
            pending += 1

        elif status_lower == "acknowledged":
            acknowledged += 1

        elif status_lower == "responded":
            responded += 1

        elif status_lower == "report submitted":
            report_submitted += 1

        elif status_lower == "completed":
            completed += 1

        elif status_lower == "needs more work":
            needs_more_work += 1

        elif status_lower == "under review":
            under_review += 1

    average_progress = (
        round(
            total_progress / total,
            1
        )
        if total
        else 0
    )

    return {

        "total": total,

        "pending": pending,

        "acknowledged": acknowledged,

        "responded": responded,

        "report_submitted":
            report_submitted,

        "completed":
            completed,

        "needs_more_work":
            needs_more_work,

        "under_review":
            under_review,

        "average_progress":
            average_progress,

        "completion_rate": (
            round(
                completed / total * 100,
                1
            )
            if total
            else 0
        ),

        "priorities":
            priorities,

        "action_types":
            action_types,

        "reason_categories":
            reason_categories
    }


# ============================================================
# CREATE INTERVENTION
# ============================================================

@app.post("/api/interventions")
def create_intervention(
    intervention_data: InterventionRequest,
    authorization: str | None = Header(default=None)
):

    _, faculty_id = get_authenticated_faculty(
        authorization
    )

    student_id = (
        intervention_data.student_id.strip()
    )

    verify_student(
        student_id
    )

    title = (
        intervention_data.title.strip()
    )

    description = (
        intervention_data.description.strip()
    )

    if not title:

        raise HTTPException(
            status_code=400,
            detail="Intervention title is required"
        )

    if not description:

        raise HTTPException(
            status_code=400,
            detail="Intervention description is required"
        )

    priority = (
        intervention_data.priority
        .strip()
        .title()
    )

    if priority not in {
        "Low",
        "Medium",
        "High",
        "Critical"
    }:

        priority = "Medium"

    action_type = (
        intervention_data.action_type.strip()
        if intervention_data.action_type
        else "Academic Support"
    )

    reason_category = (
        intervention_data.reason_category.strip()
        if intervention_data.reason_category
        else "General"
    )

    intervention = add_intervention(
        student_id,
        faculty_id,
        title,
        description,
        priority,
        intervention_data.due_date.strip(),
        action_type=action_type,
        reason_category=reason_category
    )

    # --------------------------------------------------------
    # IMPORTANT:
    #
    # storage.add_intervention() already creates the student
    # notification.
    #
    # DO NOT create another notification here.
    # --------------------------------------------------------

    # --------------------------------------------------------
    # Preserve richer frontend information if supplied.
    # storage.py currently supports these fields through
    # update_intervention().
    # --------------------------------------------------------

    extra_updates = {}

    if intervention_data.reason:

        extra_updates["reason"] = (
            intervention_data.reason.strip()
        )

    if intervention_data.recommended_action:

        extra_updates[
            "recommended_action"
        ] = (
            intervention_data
            .recommended_action
            .strip()
        )

    if intervention_data.action_taken:

        extra_updates[
            "action_taken"
        ] = (
            intervention_data
            .action_taken
            .strip()
        )

    if intervention_data.intervention_date:

        extra_updates[
            "intervention_date"
        ] = (
            intervention_data
            .intervention_date
            .strip()
        )

    if intervention_data.baseline_metrics:

        extra_updates[
            "baseline_metrics"
        ] = intervention_data.baseline_metrics

    if extra_updates:

        # Only fields supported by storage.py are persisted.
        supported_updates = {}

        for key in {
            "baseline_metrics"
        }:

            if key in extra_updates:

                supported_updates[key] = (
                    extra_updates[key]
                )

        if supported_updates:

            updated = update_intervention(
                intervention["intervention_id"],
                **supported_updates
            )

            if updated:

                intervention = updated

    return {

        "message":
            "Intervention created successfully",

        "intervention":
            intervention
    }


# ============================================================
# FACULTY UPDATE INTERVENTION
# ============================================================

@app.patch("/api/interventions/{intervention_id}")
def update_faculty_intervention(
    intervention_id: str,
    update_data: InterventionUpdateRequest,
    authorization: str | None = Header(default=None)
):

    _, faculty_id = get_authenticated_faculty(
        authorization
    )

    existing, _ = find_intervention(
        intervention_id
    )

    if existing is None:

        raise HTTPException(
            status_code=404,
            detail="Intervention not found"
        )

    verify_faculty_intervention_access(
        existing,
        faculty_id
    )

    updates = {}

    if update_data.title is not None:

        updates["title"] = (
            update_data.title.strip()
        )

    if update_data.description is not None:

        updates["description"] = (
            update_data.description.strip()
        )

    if update_data.status is not None:

        updates["status"] = (
            update_data.status.strip()
        )

    if update_data.progress is not None:

        updates["progress"] = max(
            0,
            min(
                100,
                update_data.progress
            )
        )

    if update_data.faculty_feedback is not None:

        updates["faculty_feedback"] = (
            update_data.faculty_feedback.strip()
        )

    if update_data.due_date is not None:

        updates["due_date"] = (
            update_data.due_date.strip()
        )

    if update_data.action_type is not None:

        updates["action_type"] = (
            update_data.action_type.strip()
        )

    if update_data.reason_category is not None:

        updates["reason_category"] = (
            update_data.reason_category.strip()
        )

    if update_data.outcome is not None:

        updates["outcome"] = (
            update_data.outcome.strip()
        )

    if update_data.after_metrics is not None:

        updates["after_metrics"] = (
            update_data.after_metrics
        )

    # --------------------------------------------------------
    # Fields not yet supported by storage.py are accepted by
    # the API model but intentionally not sent to storage.
    # --------------------------------------------------------

    updated = update_intervention(
        intervention_id,
        **updates
    )

    if updated is None:

        raise HTTPException(
            status_code=404,
            detail="Intervention not found"
        )

    if "status" in updates:

        add_notification(
            "student",
            updated["student_id"],
            "Intervention Updated",
            (
                f"Your intervention "
                f"'{updated['title']}' "
                f"is now {updated['status']}."
            ),
            "intervention"
        )

    return {

        "message":
            "Intervention updated successfully",

        "intervention":
            updated
    }


