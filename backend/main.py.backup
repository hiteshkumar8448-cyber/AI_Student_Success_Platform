@app.post("/api/student/{student_id}/notes")
def create_student_specific_note(
    student_id: str,
    note_data: StudentNoteRequest,
    authorization: str | None = Header(default=None)
):

    _, faculty_id = get_authenticated_faculty(
        authorization
    )

    verify_student(
        student_id
    )

    title = (
        note_data.title.strip()
        or "Faculty Note"
    )

    note_text = (
        note_data.note.strip()
    )

    if not note_text:

        raise HTTPException(
            status_code=400,
            detail="Note cannot be empty"
        )

    if len(note_text) > 2000:

        raise HTTPException(
            status_code=400,
            detail=(
                "Student note cannot exceed "
                "2000 characters"
            )
        )

    # --------------------------------------------------------
    # Never trust faculty_name sent by browser.
    # --------------------------------------------------------

    note = add_student_note(
        student_id,
        faculty_id,
        title,
        note_text
    )

    add_notification(
        "student",
        student_id,
        "New Faculty Note",
        f"Faculty added a new note: {title}",
        "note"
    )

    return {

        "message":
            "Student note added successfully",

        "note":
            note
    }


