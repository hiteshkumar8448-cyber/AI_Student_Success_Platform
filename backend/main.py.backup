# ============================================================
# STUDENTS
# ============================================================

@app.get("/api/students")
def students(
    risk: str | None = None,
    department: str | None = None,
    trend: str | None = None,
    priority: str | None = None,
    filter_type: str | None = None,
    search: str | None = None
):

    result = df.copy()

    if risk and risk != "All":

        result = result[
            result["risk_level"] == risk
        ]

    if department and department != "All":

        result = result[
            result["department"] == department
        ]

    if trend and trend != "All":

        result = result[
            result["performance_trend"] == trend
        ]

    if priority and priority != "All":

        result = result[
            result["priority_category"] == priority
        ]

    if filter_type:

        ft = filter_type.strip().lower()

        if ft == "declining":

            result = result[
                result["performance_trend"]
                == "Declining"
            ]

        elif ft == "improving":

            result = result[
                result["performance_trend"]
                == "Improving"
            ]

        elif ft == "critical":

            result = result[
                result["priority_category"]
                == "Critical"
            ]

        elif ft == "high_risk":

            result = result[
                result["priority_category"]
                == "High Risk"
            ]

        elif ft == "requiring_intervention":

            result = result[
                result["priority_category"].isin(
                    [
                        "Critical",
                        "High Risk"
                    ]
                )
            ]

        elif ft == "low_attendance":

            result = result[
                result["attendance"] < 75.0
            ]

        elif ft == "backlogs":

            result = result[
                result["backlogs"] >= 2
            ]

    if search:

        search_value = (
            search.strip().lower()
        )

        result = result[
            result["student_id"]
            .astype(str)
            .str.lower()
            .str.contains(
                search_value,
                na=False
            )
            |
            result["name"]
            .astype(str)
            .str.lower()
            .str.contains(
                search_value,
                na=False
            )
        ]

    columns = [

        "student_id",
        "name",
        "department",
        "year",

        "cgpa",
        "previous_cgpa",
        "cgpa_change",
        "cgpa_change_pct",

        "attendance",
        "backlogs",

        "success_score",

        "risk_level",
        "ai_predicted_risk",
        "ai_risk_probability",

        "performance_trend",

        "priority_category",
        "priority_badge",
        "priority_rank",
        "priority_action",

        "segment",
        "placement_outcome"
    ]

    available_columns = [
        column
        for column in columns
        if column in result.columns
    ]

    return result[
        available_columns
    ].to_dict(
        orient="records"
    )


