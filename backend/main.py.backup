# ============================================================
# STUDENT RESPOND TO INTERVENTION
# ============================================================

@app.post("/api/interventions/{intervention_id}/respond")
def student_respond_intervention(
    intervention_id: str,
    response_data: StudentInterventionResponseRequest,
    authorization: str | None = Header(default=None)
):

    user = require_student(
        authorization
    )

    if not response_data.message.strip():

        raise HTTPException(
            status_code=400,
            detail="Response message cannot be empty"
        )

    try:

        updated = respond_to_intervention(
            intervention_id,
            user["user_id"],
            response_data.message,
            progress=response_data.progress,
            new_status=(
                response_data.status
                or "Responded"
            )
        )

    except PermissionError as error:

        raise HTTPException(
            status_code=403,
            detail=str(error)
        )

    except ValueError as error:

        raise HTTPException(
            status_code=400,
            detail=str(error)
        )

    if updated is None:

        raise HTTPException(
            status_code=404,
            detail="Intervention not found"
        )

    # --------------------------------------------------------
    # storage.respond_to_intervention() already creates the
    # faculty notification.
    #
    # No second notification here.
    # --------------------------------------------------------

    return {

        "message":
            "Response submitted to faculty successfully",

        "intervention":
            updated
    }


