# ============================================================
# GLOBAL FACULTY NOTES
# ============================================================

@app.get("/api/faculty-notes")
def get_faculty_notes():

    notes = load_general_faculty_notes()

    notes.sort(
        key=lambda item: item.get(
            "created_at",
            ""
        ),
        reverse=True
    )

    return {
        "notes": notes
    }


# ============================================================
# CREATE GLOBAL FACULTY NOTE
# ============================================================

@app.post("/api/faculty-notes")
def add_faculty_note(
    note_data: GeneralFacultyNote,
    authorization: str | None = Header(default=None)
):

    _, faculty_id = get_authenticated_faculty(
        authorization
    )

    subject = (
        note_data.subject.strip()
    )

    note_text = (
        note_data.note.strip()
    )

    if not subject:

        subject = "General"

    if len(subject) > 150:

        raise HTTPException(
            status_code=400,
            detail=(
                "Subject cannot exceed "
                "150 characters"
            )
        )

    if not note_text:

        raise HTTPException(
            status_code=400,
            detail="Note cannot be empty"
        )

    if len(note_text) > 1000:

        raise HTTPException(
            status_code=400,
            detail="Note cannot exceed 1000 characters"
        )

    notes = load_general_faculty_notes()

    new_note = {

        "note_id":
            str(uuid.uuid4()),

        "faculty_name":
            faculty_id,

        "subject":
            subject,

        "note":
            note_text,

        "attachment":
            None,

        "created_at":
            now_iso()
    }

    notes.append(
        new_note
    )

    save_general_faculty_notes(
        notes
    )

    return {

        "message":
            "Faculty note added successfully",

        "note":
            new_note
    }


# ============================================================
# CREATE GLOBAL FACULTY NOTE + FILE
# ============================================================

@app.post("/api/faculty-notes/upload")
async def add_faculty_note_with_file(
    faculty_name: str = Form(""),
    subject: str = Form("General"),
    note: str = Form(""),
    attachment: UploadFile = File(...),
    authorization: str | None = Header(default=None)
):

    _, faculty_id = get_authenticated_faculty(
        authorization
    )

    subject = (
        subject.strip()
    )

    note = (
        note.strip()
    )

    if not subject:

        subject = "General"

    if len(subject) > 150:

        raise HTTPException(
            status_code=400,
            detail=(
                "Subject cannot exceed "
                "150 characters"
            )
        )

    if len(note) > 1000:

        raise HTTPException(
            status_code=400,
            detail="Note cannot exceed 1000 characters"
        )

    if not attachment.filename:

        raise HTTPException(
            status_code=400,
            detail="Please select a file"
        )

    extension = validate_extension(
        attachment.filename,
        GENERAL_NOTE_ALLOWED_EXTENSIONS
    )

    safe_filename = create_safe_filename(
        attachment.filename,
        "faculty_note"
    )

    destination = (
        FACULTY_FILES_DIR
        / safe_filename
    )

    file_size = await save_uploaded_file(
        attachment,
        destination
    )

    notes = load_general_faculty_notes()

    new_note = {

        "note_id":
            str(uuid.uuid4()),

        "faculty_name":
            faculty_id,

        "subject":
            subject,

        "note":
            note,

        "attachment": {

            "original_filename":
                attachment.filename,

            "stored_filename":
                safe_filename,

            "file_type":
                extension.replace(
                    ".",
                    ""
                ).upper(),

            "file_size":
                file_size,

            "file_size_mb":
                round(
                    file_size / (1024 * 1024),
                    2
                ),

            "url":
                f"/faculty-files/{safe_filename}"
        },

        "created_at":
            now_iso()
    }

    notes.append(
        new_note
    )

    save_general_faculty_notes(
        notes
    )

    return {

        "message":
            "Faculty note and attachment saved successfully",

        "note":
            new_note
    }


