@app.patch("/api/reports/{report_id}/review")
def faculty_review_report(
    report_id: str,
    review_data: ReportReviewRequest,
    authorization: str | None = Header(default=None)
):

    _, faculty_id = get_authenticated_faculty(
        authorization
    )

    status = (
        review_data.status.strip()
    )

    allowed_statuses = {
        "Completed",
        "Needs More Work",
        "Under Review"
    }

    if status not in allowed_statuses:

        raise HTTPException(
            status_code=400,
            detail="Invalid report review status"
        )

    report, _ = find_report(
        report_id
    )

    if report is None:

        raise HTTPException(
            status_code=404,
            detail="Report not found"
        )

    # --------------------------------------------------------
    # Make sure the report's intervention belongs to the
    # current faculty.
    # --------------------------------------------------------

    intervention, _ = find_intervention(
        report.get(
            "intervention_id"
        )
    )

    if intervention is None:

        raise HTTPException(
            status_code=404,
            detail="Related intervention not found"
        )

    verify_faculty_intervention_access(
        intervention,
        faculty_id
    )

    reviewed = review_report(
        report_id,
        status,
        review_data.faculty_feedback.strip(),
        faculty_name=faculty_id
    )

    if reviewed is None:

        raise HTTPException(
            status_code=404,
            detail="Report not found"
        )

    # --------------------------------------------------------
    # Store outcome / after metrics.
    # --------------------------------------------------------

    extra_updates = {}

    if review_data.outcome is not None:

        extra_updates[
            "outcome"
        ] = review_data.outcome.strip()

    if review_data.after_metrics is not None:

        extra_updates[
            "after_metrics"
        ] = review_data.after_metrics

    if extra_updates:

        update_intervention(
            reviewed["intervention_id"],
            **extra_updates
        )

    # --------------------------------------------------------
    # Notify the student.
    # --------------------------------------------------------

    add_notification(
        "student",
        reviewed["student_id"],
        "Intervention Report Reviewed",
        (
            f"Your intervention report has been "
            f"reviewed: {status}."
        ),
        "review"
    )

    return {

        "message":
            "Report reviewed successfully",

        "report":
            reviewed
    }


# ============================================================
# NOTIFICATIONS
# ============================================================

@app.get("/api/student/{student_id}/notifications")
def student_notifications(
    student_id: str,
    authorization: str | None = Header(default=None)
):

    user = require_student(
        authorization
    )

    if user["user_id"] != student_id:

        raise HTTPException(
            status_code=403,
            detail="Access denied"
        )

    return {

        "notifications":
            get_notifications(
                "student",
                student_id
            )
    }


@app.get("/api/faculty/notifications")
def faculty_notifications(
    authorization: str | None = Header(default=None)
):

    user, faculty_id = get_authenticated_faculty(
        authorization
    )

    return {

        "notifications":
            get_notifications(
                "faculty",
                faculty_id
            )
    }


