# ============================================================
# STUDENT LOGIN
# ============================================================

@app.post("/api/student/login")
def student_login(
    login_data: StudentLoginRequest
):

    student_id = (
        login_data.student_id
        .strip()
        .upper()
    )

    password = (
        login_data.password
        .strip()
    )

    if not student_id:

        raise HTTPException(
            status_code=400,
            detail="Student ID is required"
        )

    if not password:

        raise HTTPException(
            status_code=400,
            detail="Password is required"
        )

    student_lookup = df[
        df["student_id"]
        .astype(str)
        .str.strip()
        .str.upper()
        == student_id
    ]

    student_row = (
        student_lookup.iloc[0]
        if not student_lookup.empty
        else None
    )

    valid = verify_student_credentials(
        student_id,
        password,
        lambda sid: student_row
    )

    if not valid:

        raise HTTPException(
            status_code=401,
            detail="Invalid Student ID or password"
        )

    row = verify_student(
        student_id
    )

    token = create_session_token(
        "student",
        student_id
    )

    return {

        "message":
            "Student login successful",

        "token":
            token,

        "role":
            "student",

        "student": {

            "student_id":
                str(row["student_id"]),

            "name":
                str(row["name"]),

            "department":
                str(row["department"]),

            "year":
                safe_int(row["year"])
        }
    }


