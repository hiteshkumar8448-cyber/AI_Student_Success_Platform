# ============================================================
# STUDENT VALIDATION
# ============================================================

def verify_student(student_id):

    student_id = str(student_id).strip()

    student_ids = (
        df["student_id"]
        .astype(str)
        .str.strip()
    )

    result = df[
        student_ids == student_id
    ]

    if result.empty:

        raise HTTPException(
            status_code=404,
            detail="Student not found"
        )

    return result.iloc[0]


# ============================================================
# FILE HELPERS
# ============================================================

def create_safe_filename(
    original_filename,
    prefix
):

    extension = (
        Path(original_filename)
        .suffix
        .lower()
    )

    unique_id = uuid.uuid4().hex

    return (
        f"{prefix}_{unique_id}{extension}"
    )


def validate_extension(
    filename,
    allowed_extensions
):

    extension = (
        Path(filename)
        .suffix
        .lower()
    )

    if extension not in allowed_extensions:

        allowed = ", ".join(
            sorted(allowed_extensions)
        )

        raise HTTPException(
            status_code=400,
            detail=f"Allowed file types: {allowed}"
        )

    return extension


async def save_uploaded_file(
    upload,
    destination
):

    file_size = 0

    try:

        with open(
            destination,
            "wb"
        ) as output_file:

            while True:

                chunk = await upload.read(
                    1024 * 1024
                )

                if not chunk:
                    break

                file_size += len(chunk)

                if file_size > MAX_FILE_SIZE:

                    output_file.close()

                    if destination.exists():
                        destination.unlink()

                    raise HTTPException(
                        status_code=413,
                        detail=(
                            "File is too large. "
                            "Maximum size is 10 MB."
                        )
                    )

                output_file.write(chunk)

    except HTTPException:
        raise

    except Exception as error:

        if destination.exists():
            destination.unlink()

        raise HTTPException(
            status_code=500,
            detail=f"Unable to save file: {error}"
        )

    finally:

        await upload.close()

    return file_size


# ============================================================
# GENERAL FACULTY NOTES
# ============================================================

def load_general_faculty_notes():

    if not FACULTY_NOTES_FILE.exists():

        return []

    try:

        with open(
            FACULTY_NOTES_FILE,
            "r",
            encoding="utf-8"
        ) as file:

            data = json.load(file)

        if isinstance(data, list):

            for item in data:

                if not item.get("subject"):

                    item["subject"] = "General"

            return data

        return []

    except (
        json.JSONDecodeError,
        OSError
    ):

        return []


def save_general_faculty_notes(
    notes
):

    temporary_file = (
        FACULTY_NOTES_FILE
        .with_suffix(".tmp")
    )

    with open(
        temporary_file,
        "w",
        encoding="utf-8"
    ) as file:

        json.dump(
            notes,
            file,
            indent=4,
            ensure_ascii=False
        )

    temporary_file.replace(
        FACULTY_NOTES_FILE
    )


# ============================================================
# AI STRENGTH ENGINE
# ============================================================

def generate_strengths(row):

    strengths = []

    if row["cgpa"] >= 8:

        strengths.append({
            "strength": "Strong Academic Performance",
            "detail": (
                f"CGPA of {row['cgpa']:.2f} "
                "indicates strong overall academic performance."
            ),
            "category": "Academic"
        })

    elif row["subject_performance"] >= 75:

        strengths.append({
            "strength": "Strong Subject Performance",
            "detail": (
                "The student demonstrates strong performance "
                "across subjects."
            ),
            "category": "Academic"
        })

    if row["attendance"] >= 85:

        strengths.append({
            "strength": "Excellent Attendance",
            "detail": (
                f"Attendance is {row['attendance']:.1f}%, "
                "showing strong academic participation."
            ),
            "category": "Engagement"
        })

    elif row["attendance"] >= 75:

        strengths.append({
            "strength": "Good Attendance",
            "detail": (
                f"Attendance of {row['attendance']:.1f}% "
                "shows consistent participation."
            ),
            "category": "Engagement"
        })

    if row["lms_login_frequency"] >= 75:

        strengths.append({
            "strength": "Active LMS Usage",
            "detail": (
                "The student regularly uses the learning "
                "management system."
            ),
            "category": "Learning"
        })

    if row["assignment_completion"] >= 80:

        strengths.append({
            "strength": "Strong Assignment Completion",
            "detail": (
                f"Assignment completion is "
                f"{row['assignment_completion']:.1f}%."
            ),
            "category": "Learning"
        })

    if row["coding_score"] >= 75:

        strengths.append({
            "strength": "Strong Coding Skills",
            "detail": (
                f"Coding readiness score is "
                f"{row['coding_score']:.1f}%."
            ),
            "category": "Technical"
        })

    if row["aptitude_score"] >= 75:

        strengths.append({
            "strength": "Strong Aptitude",
            "detail": (
                f"Aptitude score is "
                f"{row['aptitude_score']:.1f}%."
            ),
            "category": "Placement"
        })

    if row["mock_interview_score"] >= 75:

        strengths.append({
            "strength": "Strong Interview Readiness",
            "detail": (
                f"Mock interview score is "
                f"{row['mock_interview_score']:.1f}%."
            ),
            "category": "Placement"
        })

    if row["technical_skill"] >= 75:

        strengths.append({
            "strength": "Strong Technical Skills",
            "detail": (
                f"Technical skill score is "
                f"{row['technical_skill']:.1f}%."
            ),
            "category": "Skills"
        })

    if row["soft_skill"] >= 75:

        strengths.append({
            "strength": "Strong Soft Skills",
            "detail": (
                f"Soft-skill score is "
                f"{row['soft_skill']:.1f}%."
            ),
            "category": "Skills"
        })

    if row["hackathons"] >= 2:

        strengths.append({
            "strength": "Hackathon Experience",
            "detail": (
                f"Participated in "
                f"{int(row['hackathons'])} hackathons."
            ),
            "category": "Engagement"
        })

    if row["certifications"] >= 3:

        strengths.append({
            "strength": "Strong Certification Profile",
            "detail": (
                f"Completed "
                f"{int(row['certifications'])} certifications."
            ),
            "category": "Career"
        })

    if row["events_participated"] >= 5:

        strengths.append({
            "strength": "Active Event Participation",
            "detail": (
                "The student actively participates "
                "in institutional events."
            ),
            "category": "Engagement"
        })

    if row["clubs_participated"] >= 2:

        strengths.append({
            "strength": "Active in Student Communities",
            "detail": (
                "The student participates in "
                "student clubs and communities."
            ),
            "category": "Engagement"
        })

    if row["student_satisfaction"] >= 80:

        strengths.append({
            "strength": "High Student Satisfaction",
            "detail": (
                f"Student satisfaction score is "
                f"{row['student_satisfaction']:.1f}%."
            ),
            "category": "Feedback"
        })

    if row["faculty_feedback"] >= 80:

        strengths.append({
            "strength": "Positive Faculty Feedback",
            "detail": (
                "Faculty feedback indicates "
                "strong overall performance."
            ),
            "category": "Feedback"
        })

    if not strengths:

        strengths.append({
            "strength": "Growth Potential",
            "detail": (
                "The student has opportunities to develop "
                "strengths across academic and career indicators."
            ),
            "category": "Development"
        })

    return strengths


# ============================================================
# AI RECOMMENDATION ENGINE
# ============================================================

def generate_recommendation(row):

    reasons = []

    if row["risk_reasons"]:

        reasons = [
            reason.strip()
            for reason in str(
                row["risk_reasons"]
            ).split(" | ")
            if reason.strip()
        ]

    strengths = generate_strengths(row)

    strength_names = [
        item["strength"]
        for item in strengths
    ]

    actions = []

    if "Low CGPA" in reasons:

        actions.append(
            "Assign an academic mentor and create "
            "a personalized study plan."
        )

    if "Multiple academic backlogs" in reasons:

        actions.append(
            "Create a backlog recovery plan with "
            "weekly academic progress tracking."
        )

    if "Low attendance" in reasons:

        actions.append(
            "Schedule attendance counselling and "
            "monitor attendance weekly."
        )

    if "Low assignment completion" in reasons:

        actions.append(
            "Create an assignment catch-up plan with "
            "weekly completion targets."
        )

    if "Low coding readiness" in reasons:

        actions.append(
            "Enroll the student in a coding practice "
            "and problem-solving program."
        )

    if "Low aptitude readiness" in reasons:

        actions.append(
            "Provide aptitude preparation resources "
            "and regular practice tests."
        )

    if "Low interview readiness" in reasons:

        actions.append(
            "Schedule mock interviews and "
            "communication practice sessions."
        )

    if row["segment"] == "Academic Strong / Placement Risk":

        actions.append(
            "Prioritize placement-readiness training "
            "because academic performance is strong "
            "but placement skills need improvement."
        )

    elif row["segment"] == "High Performer":

        actions.append(
            "Provide advanced projects, hackathon "
            "opportunities and leadership activities."
        )

    elif row["segment"] == "Highly Engaged":

        actions.append(
            "Maintain current engagement and provide "
            "advanced career-development opportunities."
        )

    elif row["segment"] == "Academic Risk":

        actions.append(
            "Assign a faculty mentor and create a "
            "structured academic recovery plan."
        )

    else:

        actions.append(
            "Schedule regular mentor check-ins and "
            "monitor academic and engagement progress."
        )

    if "Strong Coding Skills" in strength_names:

        actions.append(
            "Leverage strong coding skills through "
            "advanced coding projects and technical "
            "interview preparation."
        )

    if "Strong Academic Performance" in strength_names:

        actions.append(
            "Leverage strong academic performance for "
            "advanced projects, peer mentoring and "
            "leadership opportunities."
        )

    if "Strong Technical Skills" in strength_names:

        actions.append(
            "Leverage technical strengths by assigning "
            "practical projects and industry-oriented tasks."
        )

    actions = list(
        dict.fromkeys(actions)
    )

    if row["risk_level"] == "Immediate Support":

        priority = "Critical"

        overall = (
            "Immediate intervention is recommended. "
            "The student's risk factors should be addressed "
            "while using existing strengths as a foundation."
        )

    elif row["risk_level"] == "Needs Attention":

        priority = "High"

        overall = (
            "Early intervention is recommended. "
            "Address the identified risk factors while "
            "building on the student's strengths."
        )

    else:

        priority = "Normal"

        overall = (
            "Student is currently on track. Continue monitoring "
            "performance and use strengths to create growth opportunities."
        )

    return {
        "priority": priority,
        "overall_recommendation": overall,
        "student_strengths": strengths,
        "recommended_actions": actions
    }


# ============================================================
# STUDENT RESPONSE BUILDER
# ============================================================

def build_student_response(
    row,
    include_portal_data=True
):

    recommendation = generate_recommendation(
        row
    )

    student_id = str(
        row["student_id"]
    )

    response = {

        "student_id": student_id,

        "name": str(
            row["name"]
        ),

        "department": str(
            row["department"]
        ),

        "year": safe_int(
            row["year"]
        ),

        "success_score": safe_float(
            row["success_score"]
        ),

        "risk_level": str(
            row["risk_level"]
        ),

        "risk_reasons": (
            row["risk_reasons"].split(" | ")
            if row["risk_reasons"]
            else []
        ),

        "segment": str(
            row["segment"]
        ),

        "placement_outcome": str(
            row["placement_outcome"]
        ),

        "recommendation": recommendation,

        "academic": {

            "cgpa": safe_float(
                row["cgpa"]
            ),

            "backlogs": safe_int(
                row["backlogs"]
            ),

            "subject_performance": safe_float(
                row["subject_performance"]
            )
        },

        "attendance": safe_float(
            row["attendance"]
        ),

        "lms": {

            "login_frequency": safe_float(
                row["lms_login_frequency"]
            ),

            "assignment_completion": safe_float(
                row["assignment_completion"]
            )
        },

        "engagement": {

            "events": safe_int(
                row["events_participated"]
            ),

            "clubs": safe_int(
                row["clubs_participated"]
            ),

            "hackathons": safe_int(
                row["hackathons"]
            ),

            "certifications": safe_int(
                row["certifications"]
            )
        },

        "placement": {

            "aptitude": safe_float(
                row["aptitude_score"]
            ),

            "coding": safe_float(
                row["coding_score"]
            ),

            "mock_interview": safe_float(
                row["mock_interview_score"]
            )
        },

        "skills": {

            "technical": safe_float(
                row["technical_skill"]
            ),

            "soft": safe_float(
                row["soft_skill"]
            )
        },

        "feedback": {

            "student_satisfaction": safe_float(
                row["student_satisfaction"]
            ),

            "faculty_feedback": safe_float(
                row["faculty_feedback"]
            )
        },

        # ----------------------------------------------------
        # Academic journey
        # ----------------------------------------------------

        "previous_cgpa": safe_float(
            row.get(
                "previous_cgpa",
                row["cgpa"]
            )
        ),

        "cgpa_change": safe_float(
            row.get(
                "cgpa_change",
                0.0
            )
        ),

        "cgpa_change_pct": safe_float(
            row.get(
                "cgpa_change_pct",
                0.0
            )
        ),

        "performance_trend": str(
            row.get(
                "performance_trend",
                "Stable"
            )
        ),

        "priority_category": str(
            row.get(
                "priority_category",
                "Stable"
            )
        ),

        "priority_badge": str(
            row.get(
                "priority_badge",
                "🟢 Stable"
            )
        ),

        "priority_rank": safe_int(
            row.get(
                "priority_rank",
                5
            )
        ),

        "priority_action": str(
            row.get(
                "priority_action",
                "Routine Periodic Review"
            )
        ),

        "ai_predicted_risk": str(
            row.get(
                "ai_predicted_risk",
                "Low Risk"
            )
        ),

        "ai_risk_probability": safe_float(
            row.get(
                "ai_risk_probability",
                20.0
            )
        ),

        "ai_explanation": str(
            row.get(
                "ai_explanation",
                ""
            )
        ),

        "downgrade_details": (
            row.get(
                "downgrade_details"
            )
            if isinstance(
                row.get(
                    "downgrade_details"
                ),
                dict
            )
            else {}
        ),

        "subjects": (
            row.get(
                "subjects"
            )
            if isinstance(
                row.get(
                    "subjects"
                ),
                list
            )
            else []
        ),

        "timeline": (
            row.get(
                "timeline"
            )
            if isinstance(
                row.get(
                    "timeline"
                ),
                list
            )
            else []
        ),

        "struggling_areas": (
            row.get(
                "struggling_areas"
            )
            if isinstance(
                row.get(
                    "struggling_areas"
                ),
                list
            )
            else []
        ),

        "strong_areas": (
            row.get(
                "strong_areas"
            )
            if isinstance(
                row.get(
                    "strong_areas"
                ),
                list
            )
            else []
        ),

        "contributing_factors": (
            row.get(
                "contributing_factors"
            )
            if isinstance(
                row.get(
                    "contributing_factors"
                ),
                list
            )
            else []
        )
    }

    if include_portal_data:

        response["notes"] = get_student_notes(
            student_id
        )

        response["interventions"] = (
            get_student_interventions(
                student_id
            )
        )

        response["reports"] = (
            get_student_reports(
                student_id
            )
        )

        response["notifications"] = (
            get_notifications(
                "student",
                student_id
            )
        )

    return response


